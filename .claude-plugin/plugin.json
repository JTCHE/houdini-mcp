{
  "name": "houdini-mcp",
  "displayName": "Houdini MCP",
  "version": "0.7.0",
  "description": "Connect Claude to SideFX Houdini: read and edit the scene, cook, render, capture the viewport and read the offline documentation of your build.",
  "author": { "name": "John Chedeville", "url": "https://github.com/JTCHE" },
  "homepage": "https://github.com/JTCHE/houdini-mcp",
  "repository": "https://github.com/JTCHE/houdini-mcp",
  "license": "MIT",
  "icon": "./.claude-plugin/icon.png",
  "keywords": ["houdini", "sidefx", "vfx", "3d", "procedural"],
  "mcpServers": {
    "houdini": {
      "command": "uv",
      "args": ["run", "--frozen", "--project", "${CLAUDE_PLUGIN_ROOT}",
               "python", "${CLAUDE_PLUGIN_ROOT}/houdini_mcp_server.py"]
    }
  }
}
